<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omar Yaseen</title>
    <style>
        body {
            background-color: #050505;
            color: #00ff66;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            cursor: pointer;
        }
        .container {
            text-align: center;
            border: 1px solid #00ff66;
            padding: 30px;
            border-radius: 8px;
            background: rgba(0, 20, 10, 0.8);
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.3);
            max-width: 90%;
        }
        h1 {
            font-size: 22px;
            letter-spacing: 3px;
            margin-bottom: 15px;
            text-shadow: 0 0 10px rgba(0, 255, 102, 0.6);
        }
        p {
            color: #888;
            font-size: 13px;
        }
    </style>
</head>
<body onclick="decrypt()">

    <div class="container">
        <!-- اسم Omar Yaseen بلغة الباينري -->
        <h1 id="output">01001111 01001101 01000001 01010010 00100000 01011001 01000001 01010011 01000101 01000101 01001110</h1>
        <p>[ اضغط لفك الشفرة ]</p>
    </div>

    <script>
        function decrypt() {
            const el = document.getElementById("output");
            el.innerText = "Omar Yaseen";
            el.style.color = "#00ffff";
            el.style.textShadow = "0 0 15px rgba(0, 255, 255, 0.8)";
            
            setTimeout(() => {
                window.location.href = "https://github.com"; 
            }, 1500);
        }
    </script>

</body>
</html>
